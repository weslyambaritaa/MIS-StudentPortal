# Copy into Dokploy's Server A environment. Replace every placeholder.
DOKPLOY_NETWORK_NAME=dokploy-network
STUDENT_APP_DOMAIN=student.example.com
API_DOMAIN=api.mis.example.com
AUTH_DOMAIN=auth.mis.example.com

# Private interface on A; allow port 4001 only from Server B's private address.
STUDENT_API_BIND_IP=10.0.0.10
STUDENT_API_PORT=4001
# Internal API private address on B, used by Student API for service-to-service calls.
INTERNAL_API_PRIVATE_URL=http://10.0.0.20:4002

STUDENT_DB_NAME=student_db
STUDENT_DB_USER=mis_student
STUDENT_DB_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_SECRET

# These two values must exactly match Server B.
GATEWAY_SHARED_SECRET=REPLACE_WITH_THE_SAME_LONG_RANDOM_SECRET_ON_A_AND_B
SERVICE_SHARED_SECRET=REPLACE_WITH_THE_SAME_LONG_RANDOM_SECRET_ON_A_AND_B
