{
  "realm": "mis-student-portal",
  "enabled": true,
  "displayName": "MIS Student Portal",
  "internationalizationEnabled": true,
  "supportedLocales": ["en"],
  "defaultLocale": "en",
  "loginTheme": "mis-student-portal",
  "loginWithEmailAllowed": true,
  "registrationEmailAsUsername": false,
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 10,
  "bruteForceStrategy": "MULTIPLE",
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 60,
  "eventsEnabled": true,
  "eventsExpiration": 34560000,
  "enabledEventTypes": [
    "LOGIN", "LOGIN_ERROR", "LOGOUT", "LOGOUT_ERROR",
    "RESET_PASSWORD", "RESET_PASSWORD_ERROR", "SEND_RESET_PASSWORD", "SEND_RESET_PASSWORD_ERROR",
    "UPDATE_PASSWORD", "UPDATE_PASSWORD_ERROR", "UPDATE_CREDENTIAL", "UPDATE_CREDENTIAL_ERROR",
    "EXECUTE_ACTIONS", "EXECUTE_ACTIONS_ERROR"
  ],
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": false,
  "attributes": {
    "adminEventsExpiration": "34560000",
    "actionTokenGeneratedByUserLifespan.reset-credentials": "900"
  },
  "roles": {
    "realm": [
      {"name":"student"},{"name":"pic"},{"name":"trainer"},{"name":"sales"},
      {"name":"admin"},{"name":"finance"},{"name":"management"},
      {"name":"mis-user-provisioner","description":"Administrative identity role for MIS account provisioning; not a business role"}
    ]
  },
  "clients": [
    {
      "clientId": "mis-student-portal-frontend",
      "name": "MIS Student Portal Frontend",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "attributes": {"pkce.code.challenge.method": "S256"},
      "redirectUris": [
        "https://mis.executrain.co.id/api/auth/callback/keycloak",
        "https://mis.executrain.co.id/dashboard",
        "http://localhost:3100/api/auth/callback/keycloak",
        "http://localhost:3100/dashboard"
      ],
      "webOrigins": ["https://mis.executrain.co.id", "http://localhost:3100"],
      "fullScopeAllowed": true,
      "protocolMappers": [
        {
          "name": "frontend-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "mis-student-portal-frontend",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "student-portal-frontend",
      "name": "Student Portal Frontend",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "attributes": {"pkce.code.challenge.method": "S256"},
      "redirectUris": [
        "http://localhost:3001/dashboard",
        "http://localhost:3001/*",
        "http://localhost:3101/dashboard",
        "http://localhost:3101/*"
      ],
      "webOrigins": ["http://localhost:3001", "http://localhost:3101"],
      "fullScopeAllowed": true,
      "protocolMappers": [
        {
          "name": "student-portal-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "student-portal-frontend",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "mis-account-provisioner",
      "name": "MIS Account Provisioner Service",
      "secret": "OmA9oPUjF2Pz3B2RxOUUkVtLpIyC1uONKO6iv5Vn4u3VeRyQUNiLlAnbo213FO6C914els1779mkaBaRh9rYlX",
      "enabled": true,
      "protocol": "openid-connect",
