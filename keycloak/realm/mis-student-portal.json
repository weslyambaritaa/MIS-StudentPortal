    },
    {
      "clientId": "mis-audit-reader",
      "name": "MIS Keycloak Audit Reader",
      "secret": "3vYFsSoSUnnjDJqn2QKkHER1EMTSPBgmKu5OXVcspdkn06ZmnQpfo0xCQbOypTjQoLHgZ8t8OLuyCzSqg5qTJL",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
