# Development values only. Keep keycloak/.env local and out of Git.
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME
KC_DB=mssql
KC_DB_URL=jdbc:sqlserver://keycloak-db:1433;databaseName=keycloak_db;encrypt=false;trustServerCertificate=true
KC_DB_USERNAME=sa
KC_DB_PASSWORD=CHANGE_ME
KC_HTTP_ENABLED=true
KC_HOSTNAME=http://auth.localhost:4000
KC_HOSTNAME_ADMIN=http://auth.localhost:4000
KC_PROXY_HEADERS=xforwarded
KC_HEALTH_ENABLED=true
