{
  "name": "@mis/student-api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "predev": "npm run build --workspace @mis/shared-types",
    "dev": "tsx watch src/server.ts",
    "prebuild": "npm run build --workspace @mis/shared-types",
    "build": "tsc",
    "prestart": "npm run build --workspace @mis/shared-types",
    "start": "node dist/server.js",
    "test": "npm run build && node --test test/*.test.cjs",
    "migrate": "sequelize-cli db:migrate --config config/database.cjs",
    "migrate:undo": "sequelize-cli db:migrate:undo --config config/database.cjs",
    "seed": "sequelize-cli db:seed:all --config config/database.cjs"
  },
  "dependencies": {
    "@mis/shared-types": "*",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.1.0",
    "pg": "^8.16.0",
    "pg-hstore": "^2.3.4",
    "pino-http": "^10.4.0",
    "sequelize": "^6.37.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^24.0.0",
    "sequelize-cli": "^6.6.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
