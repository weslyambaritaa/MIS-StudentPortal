{
  "name": "@mis/internal-api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "predev": "npm run build --workspace @mis/shared-types && npm run build --workspace @mis/logger",
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "prestart": "npm run build --workspace @mis/shared-types && npm run build --workspace @mis/logger",
    "start": "node dist/server.js",
    "monitor": "tsx src/modules/monitoring/monitor.ts",
    "premonitor": "npm run build --workspace @mis/internal-api",
    "test": "npm run build && node --test test/*.test.cjs",
    "migrate": "sequelize-cli db:migrate --config config/database.cjs",
    "migrate:undo": "sequelize-cli db:migrate:undo --config config/database.cjs",
    "seed": "sequelize-cli db:seed:all --config config/database.cjs"
  },
  "dependencies": {
    "@mis/logger": "*",
    "@mis/shared-types": "*",
    "cloudinary": "^2.7.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.1.0",
    "joi": "^17.13.8",
    "nodemailer": "^7.0.5",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.17.2",
    "pg": "^8.16.3",
    "pg-hstore": "^2.3.4",
    "pino-http": "^10.4.0",
    "playwright-core": "^1.55.0",
    "sequelize": "^6.37.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^6.4.17",
    "@types/pdfkit": "^0.17.3",
    "sequelize-cli": "^6.6.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
