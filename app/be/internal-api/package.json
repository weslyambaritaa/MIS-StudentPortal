{
  "name": "@mis/internal-api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "migrate": "sequelize-cli db:migrate --config config/database.cjs",
    "migrate:undo": "sequelize-cli db:migrate:undo --config config/database.cjs",
    "seed": "sequelize-cli db:seed:all --config config/database.cjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.1.0",
    "pino-http": "^10.4.0",
    "sequelize": "^6.37.5",
    "tedious": "^18.6.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^24.0.0",
    "sequelize-cli": "^6.6.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
