# Copy into Dokploy's Server B environment. Replace every placeholder.
DOKPLOY_NETWORK_NAME=dokploy-network
APP_DOMAIN=mis.example.com
STUDENT_APP_DOMAIN=student.example.com
API_DOMAIN=api.mis.example.com
AUTH_DOMAIN=auth.mis.example.com
CORS_ORIGINS=https://mis.example.com,https://student.example.com

# Private interface on B; allow port 4002 only from Server A's private address.
INTERNAL_API_BIND_IP=10.0.0.20
INTERNAL_API_PORT=4002
# Student API private address on A, reachable only over the A-B private link.
STUDENT_API_PRIVATE_URL=http://10.0.0.10:4001

INTERNAL_DB_NAME=internal_db
INTERNAL_DB_USER=mis_internal
INTERNAL_DB_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_SECRET
KEYCLOAK_DB_NAME=keycloak_db
KEYCLOAK_DB_USER=mis_keycloak
KEYCLOAK_DB_PASSWORD=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_SECRET
KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=REPLACE_WITH_ADMIN_USERNAME
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_SECRET

# These two values must exactly match Server A.
GATEWAY_SHARED_SECRET=REPLACE_WITH_THE_SAME_LONG_RANDOM_SECRET_ON_A_AND_B
SERVICE_SHARED_SECRET=REPLACE_WITH_THE_SAME_LONG_RANDOM_SECRET_ON_A_AND_B

KEYCLOAK_AUDIENCES=mis-student-portal-frontend,student-portal-frontend
KEYCLOAK_PROVISIONER_CLIENT_ID=mis-account-provisioner
KEYCLOAK_PROVISIONER_CLIENT_SECRET=REPLACE_WITH_KEYCLOAK_CLIENT_SECRET
KEYCLOAK_AUDIT_ENABLED=false
KEYCLOAK_AUDIT_CLIENT_ID=mis-audit-reader
KEYCLOAK_AUDIT_CLIENT_SECRET=

DEVELOPER_SUPPORT_EMAIL=
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=ExecuTrain
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
