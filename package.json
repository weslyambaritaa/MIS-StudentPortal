{
  "name": "mis-student-portal",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@10.9.8",
  "workspaces": [
    "app/fe",
    "app/student-fe",
    "app/be/student-api",
    "app/be/internal-api",
    "gateway",
    "packages/shared-types",
    "packages/config",
    "packages/logger",
    "packages/ui",
    "packages/auth",
    "packages/api-client"
  ],
  "scripts": {
    "build": "turbo run build",
    "build:student": "turbo run build --filter=@mis/student-frontend --filter=@mis/student-api",
    "build:internal": "turbo run build --filter=@mis/internal-frontend --filter=@mis/internal-api --filter=@mis/gateway",
    "dev:internal": "npm run dev --workspace @mis/internal-frontend",
    "dev:student": "npm run dev --workspace @mis/student-frontend",
    "dev": "docker compose up --build",
    "down": "docker compose down",
    "logs": "docker compose logs -f",
    "ps": "docker compose ps",
    "migrate:student": "docker compose exec student-api npm run migrate",
    "migrate:internal": "docker compose exec internal-api npm run migrate",
    "migrate": "npm run migrate:student && npm run migrate:internal",
    "seed:student": "docker compose exec student-api npm run seed",
    "seed:internal": "docker compose exec internal-api npm run seed",
    "seed": "npm run seed:internal && npm run seed:student",
    "build:shared": "turbo run build --filter=@mis/shared-types --filter=@mis/config --filter=@mis/logger --filter=@mis/ui --filter=@mis/auth --filter=@mis/api-client"
  },
  "devDependencies": {
    "turbo": "^2.11.10"
  },
  "dependencies": {
    "@lordicon/element": "^3.0.2",
    "lottie-web": "^5.13.0"
  }
}
